# Brinines CRM — ENV Example — copiar a .env y completar
# Nunca commitear .env — solo .env.example
# Todos opcionales stub-safe: sin estos, el build sigue verde pero las integraciones quedan en stub

# DB — Supabase Postgres (pooler)
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Queue — Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
# Legacy alias usado en lib/queue.ts
UPSTASH_REDIS_URL=""

# Google Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"

# Meta Graph — Instagram
IG_USER_ID="462599807041091902815"
IG_ACCESS_TOKEN=""
NEXT_PUBLIC_IG_ACCESS_TOKEN=""
NEXT_PUBLIC_IG_AVATAR_URL=""

# Upstash public alias (opcional para UI)
NEXT_PUBLIC_UPSTASH_URL=""

# Cloudinary (futuro)
CLOUDINARY_URL=""

# Next
NEXT_PUBLIC_APP_URL="http://localhost:3000"
